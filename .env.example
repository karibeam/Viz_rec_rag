# Copie para .env e preencha. NUNCA versione o .env com a chave real.

# Provedor: "gemini" (padrao) ou "openai"
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Modelo usado no enriquecimento em massa (mais leve/rapido que o do runtime).
# Deixe vazio para usar GEMINI_CHAT_MODEL.
ENRICH_CHAT_MODEL=gemini-3.5-flash-lite
